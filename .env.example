# Frontend: leave empty to use local mock data.
# Set this when running the backend API.
VITE_API_BASE_URL=
# Shows seeded admin/owner credentials and an autofill button on role login pages.
# Development/demo only. Keep false for a public production build.
VITE_SHOW_DEMO_ACCOUNTS=false

# Backend API
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_DAYS=7
PUBLIC_APP_URL=http://localhost:5173
EXPOSE_RESET_TOKEN=false
APP_TIMEZONE=Asia/Jakarta
MEDIA_ROOT=/app/uploads
DATABASE_URL=postgresql://papikos:papikos@localhost:5433/papikos

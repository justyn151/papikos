{
  "name": "papikos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:api": "docker compose up --build api",
    "db:migrate": "psql \"$DATABASE_URL\" -f database/migrations/001_initial_schema.sql -f database/migrations/002_auth_schema.sql -f database/migrations/003_sessions_schema.sql -f database/migrations/004_renter_actions_schema.sql -f database/migrations/005_password_resets_schema.sql -f database/migrations/006_owner_workflows_schema.sql -f database/migrations/007_normalize_facilities.sql -f database/migrations/008_normalize_locations.sql -f database/migrations/009_renter_request_context.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f database/seeds/001_mock_data.sql",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "docker compose run --rm --no-deps api python -m unittest discover -s tests -v",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
